# ===================================================================
# WasteGuard Prototype - Environment Example (.env.example)
# Copy this file to .env and adjust variables as needed
# ===================================================================

# --- Django Security & Debug ---
SECRET_KEY=django-insecure-hazguard-sih2026-hospital-safety-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# --- Server Host IPv4 & Network ---
SERVER_HOST_IP=192.168.29.66
SERVER_PORT=8000
SERVER_BASE_URL=http://192.168.29.66:8000

# --- Prototype Station Identity & Device API Key ---
STATION_ID=STATION-01
DEVICE_API_KEY=WG-STATION01-KEY-9842F1A63C2026

# --- Device Ingest & Ping Endpoints ---
DEVICE_TELEMETRY_URL=http://192.168.29.66:8000/api/devices/sensor-data/
DEVICE_PING_URL=http://192.168.29.66:8000/api/devices/ping/?station_id=STATION-01

# --- Hardware Communication Parameters ---
SERIAL_BAUD_RATE=115200
TELEMETRY_INTERVAL_MS=3000
MOISTURE_THRESHOLD_PCT=45.0
